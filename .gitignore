# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python engine
engine/.venv/
engine/**/*.egg-info/
engine/.pytest_cache/
engine/**/__pycache__/
engine/**/*.py[cod]
engine/build/
engine/dist/

# Generated sidecar binaries are platform-specific build outputs.
src-tauri/binaries/cvgnome-engine-*
!src-tauri/binaries/.gitkeep

# Generated, verified dependency notices are shipped as application resources.
src-tauri/resources/THIRD_PARTY_NOTICES.txt
src-tauri/resources/third-party-inventory.json
scripts/__pycache__/

# Credentials and local career backup bundles must never enter source history.
.env
.env.*
!.env.example
*.cvgnome-backup

# Local vault data
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
